<odoo>
  <data>
    <record id="sge_libreria.autor_tree" model="ir.ui.view">
      <field name="name">sge_libreria.autor.tree</field>
      <field name="model">sge_libreria.autor</field>
      <field name="arch" type="xml">
        <tree string="autor">
          <field name="name"></field>
          <field name="fecha_nacimiento"/>
          <field name="nacionalidad_id"/>
        </tree>
      </field>
    </record>
    <record id="sge_libreria.autor_form" model="ir.ui.view">
      <field name="name">sge_libreria.autor.form</field>
      <field name="model">sge_libreria.autor</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>
            <group>
              <field name="name"></field>
              <field name="fecha_nacimiento"/>
              <field name="nacionalidad_id"/>
              <!-- Como alternativa a hacer un tree anidado, podemos definir un kanban -->
              <field name="libro_ids" widget="many2many_kanban">
                <kanban>
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <field name="name"/>
                        </t>
                    </templates>
                </kanban>
              </field>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>

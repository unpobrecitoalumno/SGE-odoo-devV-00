<odoo>
  <data>
    <record id="sge_libreria.libro_tree" model="ir.ui.view">
      <field name="name">sge_libreria.libro.tree</field>
      <field name="model">sge_libreria.libro</field>
      <field name="arch" type="xml">
        <tree string="Libro">
          <field name="name"></field>
          <!-- Podemos ver precio y moneda en una única columna -->
          <field name="precio" widget='monetary' options="{'currency_field': 'currency_id'}"/>
          <field name="currency_id" optional="hide"/>
          <!-- Los campos relacionales, como categoria_id, se pueden usar como cualquier otro en vistas.
          Odoo nos mostrará el atributo name del objeto relacionado. -->
          <field name="categoria_id" />
        </tree>
      </field>
    </record>
    <record id="sge_libreria.libro_form" model="ir.ui.view">
      <field name="name">sge_libreria.libro.form</field>
      <field name="model">sge_libreria.libro</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>
            <group>
              <field name="name"></field>
              <field name="precio"></field>
              <!-- En el formulario podemos permitir la selección de la moneda -->
              <field name="currency_id" />
              <!-- Los campos relacionales, como categoria_id, se pueden usar como cualquier otro en vistas.
              Odoo nos mostrará el atributo name del objeto relacionado. -->
              <field name="categoria_id" />
              <!-- Alternativa a hacer un tree anidado -->
              <field name="autor_ids" widget="many2many_kanban">
                <kanban>
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <field name="name"/>
                        </t>
                    </templates>
                </kanban>
              </field>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
